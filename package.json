{
  "name": "shadcn-vue",
  "version": "1.0.1",
  "displayName": "shadcn/vue",
  "description": "Integrate components and snippets from Shadcn/Vue directly into your IDE.",
  "publisher": "Selemondev",
  "repository": {
    "type": "git",
    "url": "https://github.com/selemondev/vscode-shadcn-vue"
  },
  "bugs": {
    "url": "https://github.com/selemondev/vscode-shadcn-vue/issues",
    "email": "selemondev19@gmail.com"
  },
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other",
    "Snippets"
  ],
  "keywords": [
    "vue3",
    "shadcn-vue",
    "shadcn-vue-snippet",
    "shadcn-vue-snippets",
    "snippet",
    "snippets",
    "vue snippets",
    "shadcn-vue snippets",
    "vue 3 typescript snippets"
  ],
  "icon": "src/images/icon.png",
  "galleryBanner": {
    "color": "#C80000",
    "theme": "dark"
  },
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "snippets": [
      {
        "language": "javascript",
        "path": "./src/snippets/imports-code-snippets.json"
      },
      {
        "language": "typescript",
        "path": "./src/snippets/imports-code-snippets.json"
      },
      {
        "language": "html",
        "path": "./src/snippets/help-code-snippets.json"
      },
      {
        "language": "javascript",
        "path": "./src/snippets/help-code-snippets.json"
      },
      {
        "language": "typescript",
        "path": "./src/snippets/help-code-snippets.json"
      },
      {
        "language": "html",
        "path": "./src/snippets/usage-code-snippets.json"
      }
    ],
    "commands": [
      {
        "command": "shadcn-vue.initCli",
        "title": "shadcn/vue: Install CLI"
      },
      {
        "command": "shadcn-vue.addNewComponent",
        "title": "shadcn/vue: Add New Component"
      },
      {
        "command": "shadcn-vue.addMultipleComponents",
        "title": "shadcn/vue: Add Multiple Components"
      },
      {
        "command": "shadcn-vue.gotoComponentDoc",
        "title": "shadcn/vue: Open Component Documentation"
      },
      {
        "command": "shadcn-vue.reloadComponentList",
        "title": "shadcn/vue: Reload Component List"
      },
      {
        "command": "shadcn-vue.gotoDoc",
        "title": "shadcn/vue: Open Documentation"
      }
    ]
  },
  "scripts": {
    "generate:patch:release": "bun scripts/release.mjs",
    "generate:minor:release": "bun scripts/release.mjs --minor",
    "generate:major:release": "bun scripts/release.mjs --major",
    "build": "tsup",
    "dev": "bun run build --watch",
    "vscode": "bun run build && bunx @vscode/vsce publish --no-dependencies",
    "ovsx": "bun run build && bunx ovsx publish --no-dependencies",
    "lint": "eslint src --ext ts",
    "typecheck": "tsc --noEmit",
    "automd": "automd"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "automd": "^0.4.3",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "ofetch": "^1.5.1"
  },
  "packageManager": "bun@1.4.3"
}
